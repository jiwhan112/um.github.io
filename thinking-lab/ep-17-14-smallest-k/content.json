                  {
                    "text": "2,2"
                  }
                ]
              ]
            },
            {
              "header": false,
              "cells": [
                [
                  {
                    "text": "[5], k=0"
                  }
                ],
                [
                  {
                    "text": "빈 목록"
                  }
                ]
              ]
            },
            {
              "header": false,
              "cells": [
                [
                  {
                    "text": "[-3,0,-1], k=2"
                  }
                ],
                [
                  {
                    "text": "-3,-1"
                  }
                ]
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "먼저 답과 근거를 적어 보세요. 힌트·정답·복습 해설은 접혀 있습니다."
            }
          ]
        }
      ]
    },
    {
      "id": "hints",
      "title": "단계별 힌트",
      "tab": "hints",
      "blocks": [
        {
          "type": "details",
          "title": "힌트 1",
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "전체를 정렬한 뒤 앞 세 장을 확인하세요."
                }
              ]
            }
          ]
        },
        {
          "type": "details",
          "title": "힌트 2",
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "중복을 제거하면 정확히 어떤 조건이 바뀌나요?"
                }
              ]
            }
          ]
        },
        {
          "type": "details",
          "title": "힌트 3",
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "세 번째 작은 값과 작은 세 장 전체는 다른 출력입니다."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "solution",
      "title": "그림 풀이",
      "tab": "solution",
      "blocks": [
        {
          "type": "details",
          "title": "정답과 풀이 보기",
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "정렬하면 [1,2,2,7,9]이므로 작은 세 장은 [1,2,2]입니다. 두 2는 각각 한 장으로 셉니다."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "중복을 지워 [1,2,7]을 만들면 7을 고르면서 그보다 작은 두 번째 2를 버리게 됩니다. 이는 가장 작은 세 항목이라는 조건에 맞지 않습니다."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "세 번째 작은 값만 물었다면 답은 2 하나지만, 이 문제는 k장 전체를 반환합니다. 출력 계약을 먼저 구별해야 합니다."
                }
              ]
            },
            {
              "type": "code",
              "language": "mermaid",
              "text": "flowchart TD\n accTitle: 정렬 후 앞 k장\n A[\"7 2 2 9 1\"] --> B[\"1 2 2 7 9\"]\n B --> C[\"앞 세 장: 1 2 2\"]"
            },
            {
              "type": "code",
              "language": "mermaid",
              "text": "flowchart TD\n accTitle: 서로 다른 값으로 바꾸는 오류\n A[\"중복 제거: 1 2 7 9\"] --> B[\"앞 세 종류: 1 2 7\"]\n B --> C[\"버린 두 번째 2가 선택한 7보다 작음\"]"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "정확성 설명 — 정렬 목록의 앞 k개는 뒤의 어떤 값보다 크지 않습니다. 따라서 뒤의 값을 골라 앞의 값을 빼는 선택보다 작거나 같은 값들로 이루어진 k개를 얻습니다. 같은 값의 등장도 원래 다중집합에서 각각 보존하므로 정확한 항목 수를 만족합니다."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "시간과 공간 — 전체 정렬에 O(n log n), 답 복사에 O(k)시간이 필요합니다. 입력 보존 여부와 정렬 방법에 따라 추가 공간이 달라집니다."
                }
              ]
            }
          ]
        }
      ]
    },
