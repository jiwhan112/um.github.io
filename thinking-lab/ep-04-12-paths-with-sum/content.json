                      {
                        "text": "0 개"
                      }
                    ]
                  ]
                },
                {
                  "header": false,
                  "cells": [
                    [
                      {
                        "text": "목표0, 노드0 하나"
                      }
                    ],
                    [
                      {
                        "text": "1 개:빈 길아님"
                      }
                    ]
                  ]
                },
                {
                  "header": false,
                  "cells": [
                    [
                      {
                        "text": "0→0→0, 목표0"
