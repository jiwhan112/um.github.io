                  {
                    "text": "000101"
                  }
                ],
                [
                  {
                    "text": "000110"
                  }
                ]
              ]
            },
            {
              "header": false,
              "cells": [
                [
                  {
                    "text": "001110"
                  }
                ],
                [
                  {
                    "text": "직접 구하세요."
                  }
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "hints",
      "title": "단계별 힌트",
      "tab": "hints",
      "blocks": [
        {
          "type": "details",
          "title": "힌트 1",
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "값을 늘리려면 어떤 0을 1로 올려야 하나요?"
                }
              ]
            }
          ]
        },
        {
          "type": "details",
          "title": "힌트 2",
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "그 0보다 오른쪽에 1이 있어야 켜진 개수를 보존할 수 있습니다."
                }
              ]
            }
          ]
        },
        {
          "type": "details",
          "title": "힌트 3",
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "가장 오른쪽의 가능한 0을 올린 뒤 남은 1을 오른쪽 끝으로 모으세요."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "solution",
      "title": "그림으로 보는 풀이",
      "tab": "solution",
      "blocks": [
        {
          "type": "details",
          "title": "정답과 그림 풀이 보기",
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "010011입니다. 값 14에서 19로 갑니다. 오른쪽에 1이 있는 가장 낮은 0인 4번을 켜고, 그 아래 네 칸에 남겨야 할 두 개의 1을 가장 오른쪽에 놓습니다."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "오른쪽부터 끝의 0 한 개와 그 앞의 1 세 개를 지나면 처음 0을 만납니다. 이 0이 올릴 자리입니다."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "그 자리를 1로 바꾸고 그 오른쪽을 모두 0으로 하면 010000입니다. 1 총 개수 3을 맞추기 위해 두 개를 끝에 놓아 010011이 됩니다."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "010101도 더 크고 1 개수도 같지만 21이므로 19보다 멀리 갑니다. 최소라는 조건은 남은 1을 낮은 자리부터 채우게 합니다."
                }
              ]
            },
            {
              "type": "code",
              "language": "mermaid",
              "text": "flowchart TD\n    accTitle: 14에서19로\n    accDescr: 전환점상승후낮은칸정리\n    A[\"001110 / 1 세 개\"] --> B[\"4번 자리 올림: 010000\"]\n    B --> C[\"남은 1 두 개를 낮은 자리로\"]\n    C --> D[\"010011 / 값 19\"]\n"
            },
            {
              "type": "code",
              "language": "mermaid",
              "text": "flowchart TD\n    accTitle: 최소후보와더큰후보\n    accDescr: 같은1 개수후보의값비교\n    S[\"4번을 올린 뒤 1 두 개 배치\"] --> A[\"끝에 배치 0011 → 전체 010011 = 19\"]\n    S --> B[\"띄워 배치 0101 → 전체 010101 = 21\"]\n    A --> C[\"낮은 자리부터 채운 쪽이 최소\"]\n    B --> C\n"
            },
            {
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "text": "왜 맞는가"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "더 큰 표시와 원본의 가장 왼쪽 차이는 원본 0이 새 1이 되는 자리입니다. 그 오른쪽의 1을 적어도 하나 줄여야 총 개수가 같습니다. 가능한 가장 낮은 그 자리를 고르면 더 높은 자리에서 바꾸는 어떤 후보보다 작습니다. 그 아래는 1 개수만 정해지므로 가장 낮은 자리부터 채운 것이 최소입니다."
                }
              ]
            },
            {
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "text": "비용을 어떻게 세는가"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "폭 w의 문자열을 한 번 훑어 전환점을 찾고 아래 칸을 채우면 O(w) 시간입니다. 종이 출력 외에는 개수와 위치 O(1) 공간만 필요합니다."
                }
              ]
            }
          ]
        },
