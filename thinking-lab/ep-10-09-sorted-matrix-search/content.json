                        "text": "한행 또는 한열"
                      }
                    ],
                    [
                      {
                        "text": "한방향으로만줄어듦"
                      }
                    ]
                  ]
                },
                {
                  "header": false,
                  "cells": [
                    [
                      {
                        "text": "같은값 여러개"
                      }
                    ],
                    [
                      {
                        "text": "아무위치나반환가능"
                      }
                    ]
                  ]
                },
                {
                  "header": false,
                  "cells": [
                    [
                      {
                        "text": "표를 한 줄로 이어 이진 탐색"
                      }
                    ],
                    [
                      {
                        "text": "행 사이 경계가 정렬되지 않아 오답 가능"
                      }
                    ]
                  ]
                },
                {
                  "header": false,
                  "cells": [
