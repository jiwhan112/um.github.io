          "type": "details",
          "title": "재현 가능한 테스트 코드 · 2026-10-22 재검증",
          "blocks": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "위 풀이 코드 아래에 다음 코드를 붙여 실행합니다. 테스트에서 사용하는 벡터 공간은 알고리즘의 추가 공간과 별개입니다."
                }
              ]
            },
            {
              "type": "code",
              "language": "cpp",
              "text": "#include <algorithm>\n#include <cassert>\n#include <climits>\n#include <iostream>\n#include <random>\n#include <vector>\n\nvoid Check(const std::vector<int>& values, int pivot) {\n    // 벡터는 테스트용 소유 저장소입니다. 생성 후 크기를 바꾸지 않습니다.\n    std::vector<Node> nodes(values.size());\n    std::vector<Node*> expected;\n    for (std::size_t i = 0; i < nodes.size(); ++i) {\n        nodes[i] = Node{values[i], i + 1 < nodes.size() ? &nodes[i+1] : nullptr};\n    }\n    // 값뿐 아니라 노드 주소 순서를 독립적으로 계산합니다.\n    for (Node& n : nodes) if (n.value < pivot) expected.push_back(&n);\n    for (Node& n : nodes) if (n.value >= pivot) expected.push_back(&n);\n    Node* out = StablePartition(nodes.empty() ? nullptr : &nodes[0], pivot);\n    for (Node* n : expected) {\n        assert(out == n); // 유실·중복·안정성 검사\n        out = out->next;\n    }\n    assert(out == nullptr); // 추가 노드나 사이클 금지\n    for (std::size_t i=0; i<nodes.size(); ++i) assert(nodes[i].value == values[i]);\n}\nint main() {\n    std::size_t count=0;\n    // 길이 0~8, {-1,0,1} 전수 × 기준값 5개\n    for (int n=0, combinations=1; n<=8; ++n, combinations*=3) {\n        for (int mask=0; mask<combinations; ++mask) {\n            int x=mask; std::vector<int> v(n);\n            for (int& value:v) { value=x%3-1; x/=3; }\n            for(int pivot=-2; pivot<=2; ++pivot) { Check(v,pivot); ++count; }\n        }\n    }\n    std::mt19937 rng(20261022);\n    for(int k=0; k<20000; ++k) {\n        std::vector<int> v(rng()%129);\n        for(int& x:v) x=static_cast<int>(rng()%2001)-1000;\n        Check(v,static_cast<int>(rng()%2001)-1000); ++count;\n    }\n    Check({INT_MIN,INT_MAX,0,INT_MIN},0); ++count;\n    Check(std::vector<int>(100000,7),7); ++count;\n    std::cout << count << \" partition cases passed\\n\";\n}\n"
            },
            {
              "type": "code",
              "language": "bash",
              "text": "g++ -std=c++11 -O2 -Wall -Wextra -Werror -pedantic partition.cpp -o partition\n./partition"
            }
          ]
