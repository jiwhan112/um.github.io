        {
          "type": "code",
          "language": "cpp",
          "text": "#include <unordered_map>\n#include <unordered_set>\n\nenum class Phase { Discover, Pressured, Solved, Rewarded };\n\nclass ChallengeFlow {\npublic:\n    void OnEnter(int id) {\n        Phase& state = phases_[id]; // 처음 생성되면 Discover\n        if (state == Phase::Discover) state = Phase::Pressured;\n    }\n\n    bool OnSolved(int id) {\n        auto it = phases_.find(id);\n        if (it == phases_.end() || it->second != Phase::Pressured)\n            return false; // 조건 미달 또는 중복 클리어\n        it->second = Phase::Solved;\n        return true;      // 여기서 Clear 이펙트 이벤트 발행\n    }\n\n    bool GrantReward(int id, int coins) {\n        auto it = phases_.find(id);\n        if (it == phases_.end() || it->second != Phase::Solved)\n            return false;\n        if (!rewarded_.insert(id).second) return false;\n        currency_ += coins;\n        it->second = Phase::Rewarded;\n        return true;      // UI/사운드에 RewardGranted 통지\n    }\n\n    void OnFailed(int id) {\n        auto it = phases_.find(id);\n        if (it != phases_.end() && it->second == Phase::Pressured)\n            it->second = Phase::Discover; // 재도전 가능\n    }\n\n    int currency() const { return currency_; }\n\nprivate:\n    std::unordered_map<int, Phase> phases_;\n    std::unordered_set<int> rewarded_; // 클리어 ID별 중복 지급 방지\n    int currency_ = 0;\n};"
        },
