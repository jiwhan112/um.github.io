        {
          "type": "paragraph",
          "content": [
            {
              "text": "다음 예제는 `Capture()`가 충돌 확인 뒤 호출되었다고 가정한다. 같은 적을 잡은 후 `Spit()`과 `Swallow()`는 서로 배타적으로 실행한다. 능력이 없는 적을 삼켜도 상태가 꼬이지 않게 하며, `DropCopy()`로 기본 상태를 복구한다. 실제 게임의 조작·애니메이션·물리 코드를 재현하지 않는다."
            }
          ]
        },
        {
          "type": "code",
          "language": "cpp",
          "text": "#include <cassert>\nenum class Ability { None, Dash, Wave };\nenum class Mode { Normal, Holding, Copied };\nstruct EnemyData { bool copyable; Ability ability; };\nclass CopyFlow {\npublic:\n    bool Capture(const EnemyData& enemy) {\n        if (mode_ != Mode::Normal) return false;\n        held_ = enemy;\n        mode_ = Mode::Holding;\n        return true;\n    }\n    bool Spit() {\n        if (mode_ != Mode::Holding) return false;\n        held_ = {false, Ability::None};\n        mode_ = Mode::Normal;\n        return true; // 외부 투사체 시스템에 이벤트 발행\n    }\n    bool Swallow() {\n        if (mode_ != Mode::Holding) return false;\n        ability_ = held_.copyable ? held_.ability : Ability::None;\n        mode_ = ability_ == Ability::None ? Mode::Normal : Mode::Copied;\n        held_ = {false, Ability::None};\n        return true;\n    }\n    bool DropCopy() {\n        if (mode_ != Mode::Copied) return false;\n        ability_ = Ability::None;\n        mode_ = Mode::Normal;\n        return true;\n    }\n    void OnHit() { if (mode_ == Mode::Copied) DropCopy(); }\n    Mode mode() const { return mode_; }\n    Ability ability() const { return ability_; }\nprivate:\n    Mode mode_ = Mode::Normal;\n    Ability ability_ = Ability::None;\n    EnemyData held_{false, Ability::None};\n};\nint main() {\n    CopyFlow novice, veteran;\n    assert(novice.Capture({false, Ability::None}));\n    assert(novice.Spit());                  // 기본 행동\n    assert(!novice.Spit());                 // 중복 발사 불가\n    assert(veteran.Capture({true, Ability::Dash}));\n    assert(veteran.Swallow());              // 선택적 획득\n    assert(veteran.ability() == Ability::Dash);\n    veteran.OnHit();                        // 실습 정책: 능력 소실\n    assert(veteran.mode() == Mode::Normal);\n    assert(veteran.ability() == Ability::None);\n}"
        },
