                  }
                ],
                [
                  {
                    "text": "주의"
                  }
                ]
              ]
            },
            {
              "header": false,
              "cells": [
                [
                  {
                    "text": "팀·선수의 식별"
                  }
                ],
                [
                  {
                    "text": "누가 누구인가"
                  }
                ],
                [
                  {
                    "text": "색만으로 구분하지 않기"
                  }
                ]
              ]
            },
            {
              "header": false,
              "cells": [
                [
                  {
                    "text": "현재 목표"
                  }
