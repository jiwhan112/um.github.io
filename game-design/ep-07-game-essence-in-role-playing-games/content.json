        {
          "type": "code",
          "language": "cpp",
          "text": "#include <cassert>\n#include <algorithm>\nenum class Command { Attack, Spell, Guard, Escape };\nenum class Outcome { Playing, Win, Lose, Escaped };\nstruct State {\n    int playerHp = 20, playerMp = 5, enemyHp = 19, gold = 0;\n    bool nextHeavyAttack = false;\n    Outcome outcome = Outcome::Playing;\n};\nclass Battle {\npublic:\n    bool Step(Command command) {\n        if (state_.outcome != Outcome::Playing) return false;\n        if (command == Command::Spell && state_.playerMp < 3) return false;\n        if (command == Command::Escape) {\n            state_.outcome = Outcome::Escaped; // 예제 정책: 확정 도주\n            return true;\n        }\n        const bool guarding = command == Command::Guard;\n        if (command == Command::Attack) state_.enemyHp -= 5;\n        if (command == Command::Spell) {\n            state_.playerMp -= 3;\n            state_.enemyHp -= 9;\n        }\n        if (state_.enemyHp <= 0) {\n            state_.enemyHp = 0;\n            state_.gold += 12; // 승리 진입 시 한 번만 지급\n            state_.outcome = Outcome::Win;\n            return true;\n        }\n        int damage = state_.nextHeavyAttack ? 9 : 4;\n        if (guarding) damage = (damage + 1) / 2;\n        state_.playerHp = std::max(0, state_.playerHp - damage);\n        state_.nextHeavyAttack = !state_.nextHeavyAttack;\n        if (state_.playerHp == 0) state_.outcome = Outcome::Lose;\n        return true;\n    }\n    const State& Get() const { return state_; }\nprivate:\n    State state_;\n};\nint main() {\n    Battle cautious;\n    assert(cautious.Step(Command::Attack));\n    assert(cautious.Get().nextHeavyAttack);\n    assert(cautious.Step(Command::Guard)); // 예고된 강타 완화\n    assert(cautious.Get().playerHp == 11);\n\n    Battle spender;\n    assert(spender.Step(Command::Spell));\n    assert(spender.Get().playerMp == 2);\n    assert(!spender.Step(Command::Spell)); // 자원 부족은 턴 미소비\n    assert(spender.Get().playerMp == 2);\n\n    Battle escape;\n    assert(escape.Step(Command::Escape));\n    assert(escape.Get().outcome == Outcome::Escaped);\n    assert(!escape.Step(Command::Attack)); // 종료 뒤 행동 불가\n}"
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "여기서의 assert는 명령 계약을 설명하기 위한 것이며 이번 발행에서 컴파일·실행했다고 주장하지 않는다. 현실 프로젝트에는 세이브/로드 재현성, 중복 보상 방지 ID, 상태 복구, 데이터 유효성 검사, 30/60FPS에서도 동일한 시뮬레이션 결과가 보장되는 고정 틱 등이 필요하다."
            }
