            }
          ]
        },
        {
          "type": "code",
          "text": "char formatted[16];\nint needed = snprintf(formatted, sizeof formatted, \"%s-%d\", tag, 356);\nif (needed < 0 || (size_t)needed >= sizeof formatted) {\n    // 출력 실패나 잘림을 처리합니다.\n}\nchar shifted[] = \"ABCDE\";\nmemmove(shifted + 1, shifted, 4); // 겹치는 범위도 이동 가능\nassert(strcmp(shifted, \"AABCD\") == 0);",
          "language": "c"
