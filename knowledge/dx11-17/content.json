                  }
                ]
              ]
            },
            {
              "header": false,
              "cells": [
                [
                  {
                    "text": "Advance"
                  }
                ],
                [
                  {
                    "text": "다음 글리프 시작 위치로 펜을 이동할 거리"
                  }
                ],
