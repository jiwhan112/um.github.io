        {
          "type": "paragraph",
          "content": [
            {
              "text": "C++ 한국어 주석판 main.cpp",
              "kind": "link",
              "href": "/knowledge/shared/c01-lab/ko/c01b/main.cpp"
            }
          ]
        },
        {
          "type": "details",
          "title": "C11 한국어 주석 전체 소스 보기",
          "blocks": [
            {
              "type": "code",
              "text": "// scanf의 대입 성공 개수를 확인하고, 덧셈 전에 각 피연산자를 확장합니다.\n// C11 코드이며 이 실습에서는 C++11·C++20에서도 동일한 소스를 컴파일합니다.\n#include <stdio.h>\n#include <stdint.h>\n#include <inttypes.h>\n\nint main(void) {\n    int a = 0, b = 0;\n    // 성공적으로 변환하여 대입한 항목이 정확히 두 개인지 확인합니다.\n    if (scanf(\"%d %d\", &a, &b) != 2) {\n        fputs(\"Expected two integers.\\n\", stderr);\n        return 1;\n    }\n    printf(\"You entered: %d and %d\\n\", a, b);\n    // int 덧셈 전에 각각 int64_t로 바꾸어 32비트 합계 범위를 확보합니다.\n    printf(\"Sum: %\" PRId64 \"\\n\", (int64_t)a + (int64_t)b);\n    return 0;\n}\n",
              "language": "c"
            }
          ]
        },
        {
          "type": "details",
          "title": "C++ 한국어 주석 전체 소스 보기",
          "blocks": [
            {
              "type": "code",
              "text": "// C01 CPU 전용 예제입니다. Windows/GPU API를 사용하지 않고 C++11과 C++20에서 빌드합니다.\n#include <climits>\n#include <iostream>\n#include <sstream>\n#include <string>\n\n// 부호 있는 덧셈을 수행하기 전에 INT_MAX/INT_MIN을 기준으로 범위를 검사합니다.\nbool checkedAdd(int a, int b, int& result) {\n    if ((b > 0 && a > INT_MAX - b) || (b < 0 && a < INT_MIN - b))\n        return false;\n    result = a + b;\n    return true;\n}\n// 두 정수 이외에 남는 토큰이 있으면 잘못된 입력으로 처리합니다.\nbool parse(const std::string& text, int& a, int& b) {\n    std::istringstream in(text);\n    if (!(in >> a >> b)) return false;\n    std::string extra;\n    return !(in >> extra);\n}\n// 서로 다른 입력 계약 10개를 검사합니다. 반복 빌드 수를 독립 조건으로 합산하지 않습니다.\nint selftest() {\n    int v = 0, a = 0, b = 0;\n    const bool t[] = {\n        checkedAdd(1, 2, v) && v == 3,\n        checkedAdd(-3, -4, v) && v == -7,\n        !checkedAdd(INT_MAX, 1, v),\n        !checkedAdd(INT_MIN, -1, v),\n        checkedAdd(INT_MAX, 0, v) && v == INT_MAX,\n        checkedAdd(INT_MIN, 0, v) && v == INT_MIN,\n        parse(\"1 2\", a, b) && a == 1 && b == 2,\n        !parse(\"1 bad\", a, b),\n        !parse(\"1 2 extra\", a, b),\n        !parse(\"\", a, b)\n    };\n    for (unsigned i = 0; i < sizeof(t) / sizeof(t[0]); ++i) {\n        if (!t[i]) { std::cerr << \"FAIL condition \" << i << '\\n'; return 1; }\n    }\n    std::cout << \"PASS 10 independent conditions\\n\";\n    return 0;\n}\nint main(int argc, char** argv) {\n    if (argc == 2 && std::string(argv[1]) == \"--test\") return selftest();\n    if (argc != 1) return 2;\n    std::string line;\n    if (!std::getline(std::cin, line)) return 1;\n    int a = 0, b = 0, v = 0;\n    if (!parse(line, a, b)) { std::cerr << \"invalid input\\n\"; return 1; }\n    // 실패 시 출력이나 상태 변경 전에 명시적 오류 코드로 종료합니다.\n    if (!checkedAdd(a, b, v)) { std::cerr << \"overflow\\n\"; return 2; }\n    std::cout << v << '\\n';\n    return 0;\n}\n",
              "language": "cpp"
            }
          ]
        }
      ]
    },
