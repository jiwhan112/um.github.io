        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "CPU 원본 파일: SHA256 "
            },
            {
              "text": "6a3ec20edb17657ced8a261515b9d09cb09d2bafbb4dfa916b726fef949abb3e",
              "kind": "code"
