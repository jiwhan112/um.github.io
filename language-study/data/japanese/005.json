  "grammar": {
    "title": "「〜ですか」로 질문하기",
    "explanation": "「A は B です」 끝에 「か」를 붙이면 「A は B ですか。」(A는 B입니까?)라는 정중한 질문이 됩니다. 긍정 대답은 「はい、B です。」, 부정 대답은 오늘은 간단하게 「いいえ、C です。」(아니요, C입니다)를 연습합니다. 조사 は는 '와'로 발음합니다."
  },
  "examples": [
    {
      "jp": "これは はな ですか。",
      "pron": "코레와 하나 데스카.",
      "ko": "이것은 꽃입니까?"
    },
    {
      "jp": "はい、はな です。",
      "pron": "하이, 하나 데스.",
      "ko": "네, 꽃입니다."
    },
    {
      "jp": "あれは ふね ですか。",
      "pron": "아레와 후네 데스카.",
      "ko": "저것은 배입니까?"
    },
    {
      "jp": "はい、ふね です。",
      "pron": "하이, 후네 데스.",
      "ko": "네, 배입니다."
    },
    {
      "jp": "これは かさ ですか。",
      "pron": "코레와 카사 데스카.",
      "ko": "이것은 우산입니까?"
    },
    {
      "jp": "いいえ、ほん です。",
      "pron": "이이에, 혼 데스.",
      "ko": "아니요, 책입니다."
    },
    {
      "jp": "それは ねこ ですか。",
      "pron": "소레와 네코 데스카.",
      "ko": "그것은 고양이입니까?"
    },
    {
      "jp": "はい、ねこ です。",
