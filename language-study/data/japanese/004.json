  "grammar": {
    "title": "これ・それ・あれ",
    "explanation": "これ는 말하는 사람 가까이에 있는 ‘이것’, それ는 듣는 사람 가까이에 있는 ‘그것’, あれ는 둘 모두에게서 떨어진 ‘저것’을 가리킵니다. 기본 문장은 「これは〜です」「それは〜です」「あれは〜です」 형태입니다."
  },
  "examples": [
    {
      "jp": "これは ほん です。",
      "pron": "코레와 혼 데스.",
      "ko": "이것은 책입니다."
    },
    {
      "jp": "それは かさ です。",
      "pron": "소레와 카사 데스.",
      "ko": "그것은 우산입니다."
    },
    {
      "jp": "あれは ねこ です。",
      "pron": "아레와 네코 데스.",
      "ko": "저것은 고양이입니다."
    },
    {
      "jp": "それは なに ですか。",
      "pron": "소레와 나니 데스카.",
      "ko": "그것은 무엇입니까?"
    },
    {
      "jp": "あれは いぬ です。",
      "pron": "아레와 이누 데스.",
      "ko": "저것은 개입니다."
    }
  ]
